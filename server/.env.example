NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/linkforge

# Authentication
AUTH_ACCESS_TOKEN_SECRET=REPLACE_WITH_A_RANDOM_32_BYTE_BASE64URL_SECRET
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_ISSUER=linkforge-api
AUTH_AUDIENCE=linkforge-client

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json


EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your-16-character-app-password
EMAIL_FROM="LinkForge <your-gmail-address@gmail.com>"

APP_BASE_URL=http://localhost:5000

$env:DATABASE_URL = "postgresql://postgres:1234@localhost:5432/linkforge_admin_test?schema=public"
