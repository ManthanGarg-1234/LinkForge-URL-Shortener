
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OAuthProvider {
  GOOGLE
}

enum ShortUrlModerationStatus {
  APPROVED
  BLOCKED
}

enum AbuseReportReason {
  PHISHING
  MALWARE
  SPAM
  SCAM
  OTHER
}

enum AbuseReportStatus {
  PENDING
  DISMISSED
  CONFIRMED
}

enum SecurityEventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SecurityEventStatus {
  OPEN
  REVIEWED
  RESOLVED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(255)
  name            String?    @db.VarChar(100)
  passwordHash    String?    @db.VarChar(255)
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?

  suspendedAt        DateTime?
  suspensionReason   String?  @db.VarChar(500)
  suspendedByAdminId String?  @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  oauthAccounts           OAuthAccount[]
  shortUrls               ShortUrl[]

  suspendedByAdmin User?  @relation("UserSuspendedByAdmin", fields: [suspendedByAdminId], references: [id], onDelete: SetNull)
  usersSuspended   User[] @relation("UserSuspendedByAdmin")

  moderatedShortUrls ShortUrl[] @relation("ShortUrlModeratedByAdmin")

  abuseReportsSubmitted AbuseReport[] @relation("AbuseReportReporter")
  abuseReportsReviewed  AbuseReport[] @relation("AbuseReportReviewer")

  auditLogs AuditLog[] @relation("AuditLogActor")

  securityEventsCreated  SecurityEvent[] @relation("SecurityEventSourceUser")
  securityEventsReviewed SecurityEvent[] @relation("SecurityEventReviewer")

  @@index([status, createdAt])
  @@index([suspendedByAdminId])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  userAgent String?  @db.VarChar(500)
  ipAddress String?  @db.VarChar(64)

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  tokenHash String   @unique @db.VarChar(64)

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, usedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(64)

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(64)

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @db.VarChar(255)
  email             String?       @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model ShortUrl {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  shortCode   String   @unique @db.VarChar(16)
  originalUrl String   @db.VarChar(2048)
  isActive    Boolean  @default(true)
  expiresAt   DateTime?

  moderationStatus   ShortUrlModerationStatus @default(APPROVED)
  moderatedAt        DateTime?
  moderationReason   String?                  @db.VarChar(500)
  moderatedByAdminId String?                  @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clickEvents ClickEvent[]

  moderatedByAdmin User? @relation("ShortUrlModeratedByAdmin", fields: [moderatedByAdminId], references: [id], onDelete: SetNull)

  abuseReports AbuseReport[]

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([moderationStatus, createdAt])
  @@index([moderatedByAdminId])
  @@map("short_urls")
}

model ClickEvent {
  id             String   @id @default(uuid()) @db.Uuid
  shortUrlId     String   @db.Uuid
  clickedAt      DateTime @default(now())
  referrerOrigin String?  @db.VarChar(255)

  shortUrl ShortUrl @relation(fields: [shortUrlId], references: [id], onDelete: Cascade)

  @@index([shortUrlId, clickedAt])
  @@index([clickedAt])
  @@map("click_events")
}

model AbuseReport {
  id String @id @default(uuid()) @db.Uuid

  shortUrlId String? @db.Uuid
  shortCode  String  @db.VarChar(16)

  reporterUserId String? @db.Uuid

  reason      AbuseReportReason
  description String?           @db.VarChar(2000)
  status      AbuseReportStatus @default(PENDING)

  reviewedByAdminId String?   @db.Uuid
  reviewedAt        DateTime?
  resolutionNote    String?   @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shortUrl ShortUrl? @relation(fields: [shortUrlId], references: [id], onDelete: SetNull)

  reporter User? @relation("AbuseReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)

  reviewedByAdmin User? @relation("AbuseReportReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([shortUrlId, status])
  @@index([reporterUserId, createdAt])
  @@index([reviewedByAdminId])
  @@map("abuse_reports")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorUserId String? @db.Uuid

  action     String @db.VarChar(100)
  entityType String @db.VarChar(50)
  entityId   String @db.VarChar(100)

  metadata  Json?
  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(500)

  createdAt DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SecurityEvent {
  id String @id @default(uuid()) @db.Uuid

  eventType String                @db.VarChar(100)
  severity  SecurityEventSeverity @default(LOW)
  status    SecurityEventStatus   @default(OPEN)

  sourceUserId String? @db.Uuid

  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(500)
  details   Json?

  reviewedByAdminId String?   @db.Uuid
  reviewedAt        DateTime?

  createdAt DateTime @default(now())

  sourceUser User? @relation("SecurityEventSourceUser", fields: [sourceUserId], references: [id], onDelete: SetNull)

  reviewedByAdmin User? @relation("SecurityEventReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([status, severity, createdAt])
  @@index([sourceUserId, createdAt])
  @@index([ipAddress, createdAt])
  @@index([reviewedByAdminId])
  @@map("security_events")
}
